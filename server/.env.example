# ===== Server =====
HOST=0.0.0.0
PORT=8080
# JWT 签名密钥（生产必改）
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h
# 元数据存储（SQLite 文件路径）
DATA_DIR=./data
# 首次初始化的管理员（仅首次启动生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 加密数据库密码的密钥（AES-256-GCM，需 32 字节）
SECRET_KEY=0123456789abcdef0123456789abcdef

# ===== AI 安全审计（OpenAI 兼容接口） =====
# 留空则仅使用内置规则引擎
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# strict: 高危必须二次确认 | warn: 仅告警 | off: 关闭 AI（仅规则）
AUDIT_MODE=strict
